{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CheckoutRequest",
  "type": "object",
  "required": ["shipping_address", "payment_method"],
  "properties": {
    "shipping_address": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500
    },
    "payment_method": {
      "type": "string",
      "enum": ["credit_card", "debit_card", "pix", "boleto"]
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
